#!/bin/bash
#SBATCH --job-name=minion_array
#SBATCH --array=107,139
#SBATCH --time=2-00:00:00               # Max runtime (HH:MM:SS) - adjust if Minion takes longer
#SBATCH --mem=4G                       # RAM per job
#SBATCH --cpus-per-task=1              # CPU cores per job
#SBATCH --output=logs/job_%a.out       # Standard output log (%a gets replaced by the ID 1-139)
#SBATCH --error=logs/job_%a.err        # Error log

# Create a logs directory if it doesn't exist so your folder doesn't get messy
mkdir -p logs

# SLURM_ARRAY_TASK_ID is automatically generated by Slurm (1, 2, 3... up to 139)
# Pass it into your script exactly like the $i in your loop!
bash ./findsinglesol.sh $SLURM_ARRAY_TASK_ID

